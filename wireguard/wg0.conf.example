# Copy this file to a private location, replace the placeholders, and do not commit secrets.
# Then either mount it at /etc/wireguard/wg0.conf or base64-encode it into WIREGUARD_CONFIG_B64.

[Interface]
PrivateKey = REPLACE_WITH_CLIENT_PRIVATE_KEY
Address = 10.2.0.2/32, 2a07:b944::2:2/128
DNS = 10.2.0.1, 2a07:b944::2:1

[Peer]
PublicKey = REPLACE_WITH_SERVER_PUBLIC_KEY
AllowedIPs = 0.0.0.0/0, ::/0
Endpoint = REPLACE_WITH_SERVER_ENDPOINT:51820
PersistentKeepalive = 25
